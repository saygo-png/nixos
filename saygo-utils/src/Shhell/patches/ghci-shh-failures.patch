+-- | Whether this is shh's exception for a command that exited with an error,
+-- and if so, the command's error output if shh captured it. Otherwise the
+-- command printed its own errors, so there is nothing to add, like in a shell.
+-- Exceptions from evaluated code arrive as an ErrorCall holding their shown
+-- text (see GHCi.Message.SerializableException), so this matches shh's text.
+shhFailure :: SomeException -> Maybe (Maybe String)
+shhFailure se = do
+  ErrorCall s <- fromException se
+  rest <- Data.List.stripPrefix "Command `" s
+  guard (any (isExit . Data.List.stripPrefix "` failed [exit ") (Data.List.tails rest))
+  guard ("] at CallStack (from HasCallStack):" `Data.List.isInfixOf` s)
+  Just (listToMaybe [x | x <- Data.List.tails s, "\n-- stderr --\n" `isPrefixOf` x])
+  where
+    isExit = maybe False (\c -> not (null (takeWhile isDigit c)))
+
