+-- :forget
+
+-- | Takes these names defined at the prompt out of scope, as if they weren't
+-- defined. Things defined with them keep working.
+forgetNames :: GhciMonad m => String -> m ()
+forgetNames str = do
+  modifySession $ \hsc ->
+    let ic = hsc_IC hsc
+        kept = filter ((`notElem` words str) . getOccString) (ic_tythings ic)
+        prompt_env = icExtendGblRdrEnv True emptyGlobalRdrEnv kept
+    in hsc { hsc_IC = ic { ic_tythings = kept
+                         , ic_gre_cache = (ic_gre_cache ic) { igre_prompt_env = prompt_env } } }
+  -- Rebuilds the scope from the imports and the prompt's names.
+  GHC.setContext =<< GHC.getContext
+
+-----------------------------------------------------------------------------
 -- :undef
 
 undefineMacro :: GhciMonad m => String -> m ()
