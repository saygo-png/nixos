cabal-version: 3.0
name: saygo-utils
version: 0
build-type: Simple
author: saygo-png
maintainer: saygo-png <saygo.mail@proton.me>
description: Utilities for my NixOS config

common warnings
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-missed-specialisations
    -Wno-missing-exported-signatures
    -Wno-missing-import-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-safe
    -Wno-unsafe
    -Wno-unticked-promoted-constructors

common threaded
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

common common-options
  import: warnings
  build-depends: base
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    MultiWayIf
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    PartialTypeSignatures

-- Bakes in the tools a program runs, the packages in its x-runtime-inputs, see
-- src/Bin.hs.
common bin
  hs-source-dirs:
    .
    src

  other-modules: Bin
  build-depends:
    directory,
    filepath,
    template-haskell,
    text,

-- Modules for shhell's GHCi session, which has them in its GHC environment.
library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Shhell.Direnv
    Shhell.Prompt
    Shhell.Use

  build-depends:
    Glob,
    PyF,
    bytestring,
    containers,
    directory,
    filepath,
    os-string,
    relude,
    shh,
    shh-extras,
    template-haskell,
    unix,
    yocto,

executable niri-switch-keyboard
  import: common-options, threaded
  main-is: src/niri-switch-keyboard.hs
  build-depends:
    relude,
    shh,

executable timezones
  import: common-options, threaded
  main-is: src/timezones.hs
  build-depends:
    bytestring,
    optparse-applicative,
    relude,
    time,
    tz,

executable owt
  import: common-options, threaded
  main-is: src/owt.hs
  build-depends:
    bytestring,
    cassava,
    directory,
    filepath,
    optparse-applicative,
    relude,
    time,

-- Not threaded, which starts about 1.5 ms faster: it only sets up and execs GHCi.
executable shhell
  import: common-options
  main-is: src/shhell.hs
  build-depends:
    directory,
    file-io,
    filepath,
    os-string,
    relude,
    template-haskell,
    unix,

-- Benchmarks shhell in a terminal: startup, prompt, commands and direnv.
executable shhell-bench
  import: common-options
  main-is: src/shhell-bench.hs
  -- Threaded, since it waits for a child while another thread reads its terminal.
  ghc-options: -threaded
  build-depends:
    bytestring,
    directory,
    file-io,
    filepath,
    os-string,
    relude,
    saygo-utils,
    shh,
    tasty,
    tasty-bench,
    unix,

-- GHCi's linker for shhell, see src/ghc-link-cache.hs. Not threaded, which
-- starts about 1 ms faster: it runs three times as GHCi starts and only waits
-- on the real linker.
executable ghc-link-cache
  import: common-options
  main-is: src/ghc-link-cache.hs
  build-depends:
    bytestring,
    cryptohash-sha256,
    directory,
    file-io,
    filepath,
    os-string,
    process,
    relude,
    template-haskell,
    time,
    unix,

executable ow-gen1-selector
  import: common-options, threaded
  main-is: src/ow-gen1-selector.hs
  build-depends:
    optparse-applicative,
    relude,
    shh,

executable free-space
  import: common-options, threaded
  main-is: src/free-space.hs
  build-depends:
    Cabal,
    directory,
    filepath,
    optparse-applicative,
    relude,
    shh,
    unix,
    vector,

executable tmux-mem
  import: common-options
  main-is: src/tmux-mem.hs
  build-depends:
    bytestring,
    relude,

executable convertlink
  import: common-options, threaded
  main-is: src/convertlink.hs
  build-depends:
    containers,
    directory,
    filepath,
    optparse-applicative,
    os-string,
    relude,
    unix,
    vector,

executable saygo-record
  import: common-options, threaded, bin
  main-is: src/saygo-record.hs
  x-runtime-inputs: wl-screenrec, pipewire, libnotify, ripdrag
  build-depends:
    containers,
    directory,
    filepath,
    microaeson,
    optparse-applicative,
    process,
    relude,
    shh,
    time,
    unix,

executable githubloc
  import: common-options, threaded
  main-is: src/githubloc.hs
  build-depends:
    bytestring,
    cassava,
    granite,
    optparse-applicative,
    relude,
    time,
    vector,

-- Launches a lazy package or a program from comma, detached from the terminal.
executable comma-bg
  import: common-options, threaded
  main-is: src/comma-bg.hs
  build-depends:
    containers,
    filepath,
    process,
    relude,
    shh,
    yocto,

executable clean-nix-paths
  import: common-options, threaded
  main-is: src/clean-nix-paths.hs
  build-depends:
    relude,
    text,

-- Not threaded, which starts faster: it only execs nix.
executable nr
  import: common-options
  main-is: src/nr.hs
  build-depends:
    optparse-applicative,
    relude,
    unix,

executable snr
  import: common-options
  main-is: src/nr.hs
  build-depends:
    optparse-applicative,
    relude,
    unix,

executable fzfcd
  import: common-options, threaded, bin
  main-is: src/fzfcd.hs
  x-runtime-inputs: fd, fzf, eza
  build-depends:
    directory,
    filepath,
    optparse-applicative,
    relude,
    shh,

executable pasteimg
  import: common-options, threaded, bin
  main-is: src/pasteimg.hs
  x-runtime-inputs: wl-clipboard
  build-depends:
    optparse-applicative,
    relude,
    shh,

-- Built to start fast.
-- not threaded and without the RTS's timer (-V0), which only matters for longer running programs.
-- A small allocation area (-A64k) and minimum old generation (-O64k) keep the daemon at ~7 MB while a key is held,
-- instead of past 20 MB with GHC's defaults of 4 MB and 1 MB. It never has more than ~120 KB live.
executable volume
  import: common-options, bin
  main-is: src/volume.hs
  x-runtime-inputs: wireplumber
  ghc-options: "-with-rtsopts=-V0 -A64k -O64k"
  build-depends:
    optparse-applicative,
    process,
    relude,

-- What the next boot deletes, see modules/impermanence.nix.
executable persist
  import: common-options
  main-is: src/persist.hs
  build-depends:
    directory,
    filepath,
    optparse-applicative,
    relude,
    text,
    unix,

executable hwinfolist
  import: common-options
  main-is: src/hwinfolist.hs
  build-depends:
    optparse-applicative,
    relude,

executable mynix-clean
  import: common-options, threaded, bin
  main-is: src/mynix-clean.hs
  x-runtime-inputs: nh
  build-depends:
    optparse-applicative,
    relude,
    shh,

executable mynix-list-packages
  import: common-options, threaded
  main-is: src/mynix-list-packages.hs
  build-depends:
    optparse-applicative,
    relude,
    shh,
    text,
