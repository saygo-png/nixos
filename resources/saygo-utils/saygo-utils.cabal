cabal-version: 3.0
name: saygo-utils
version: 0
build-type: Simple
author: saygo-png
maintainer: saygo-png <saygo.mail@proton.me>
description: Utilities for my NixOS config

common warnings
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-missed-specialisations
    -Wno-missing-exported-signatures
    -Wno-missing-import-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-safe
    -Wno-unsafe
    -Wno-unticked-promoted-constructors
    -threaded

common threaded
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

common common-options
  import: warnings
  build-depends: base
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    MultiWayIf
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    PartialTypeSignatures

executable niri-switch-keyboard
  import: common-options, threaded
  main-is: src/niri-switch-keyboard.hs
  build-depends:
    relude,
    shh,

executable timezones
  import: common-options, threaded
  main-is: src/timezones.hs
  build-depends:
    bytestring,
    optparse-applicative,
    relude,
    time,
    tz,

executable owt
  import: common-options, threaded
  main-is: src/owt.hs
  build-depends:
    bytestring,
    cassava,
    directory,
    filepath,
    optparse-applicative,
    relude,
    time,

executable shhell
  import: common-options, threaded
  main-is: src/shhell.hs
  build-depends:
    directory,
    unix,
    template-haskell,
    text,
    filepath,
    file-io,
    bytestring,
    relude,
    shh,
    shh-extras,

executable ow-gen1-selector
  import: common-options, threaded
  main-is: src/ow-gen1-selector.hs
  build-depends:
    optparse-applicative,
    relude,
    shh,

executable free-space
  import: common-options, threaded
  main-is: src/free-space.hs
  build-depends:
    Cabal,
    directory,
    filepath,
    optparse-applicative,
    relude,
    shh,
    unix,
    vector,

executable tmux-mem
  import: common-options
  main-is: src/tmux-mem.hs
  build-depends:
    bytestring,
    relude,

executable convertlink
  import: common-options, threaded
  main-is: src/convertlink.hs
  build-depends:
    Cabal,
    containers,
    directory,
    filepath,
    optparse-applicative,
    relude,
    unix,
    vector,

executable saygo-record
  import: common-options, threaded
  main-is: src/saygo-record.hs
  build-depends:
    Cabal,
    directory,
    filepath,
    optparse-applicative,
    relude,
    shh,
    unix,

executable githubloc
  import: common-options, threaded
  main-is: src/githubloc.hs
  build-depends:
    bytestring,
    cassava,
    granite,
    optparse-applicative,
    relude,
    time,
    vector,

executable clean-nix-paths
  import: common-options, threaded
  main-is: src/clean-nix-paths.hs
  build-depends:
    relude,
    text,
